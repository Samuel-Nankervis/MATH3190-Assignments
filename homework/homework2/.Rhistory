#boxplot function I made earlier
box = function(values, by,X,Y,Title){
df = data.frame(values, by)
ggplot(df, aes(x = by, y = values)) +
geom_boxplot(color = "black", fill = "white") +
labs(x = X, y = Y,title = Title) +
scale_fill_brewer() +
theme(plot.title = element_text(size = 18, face = "bold"))
}
box(delayAirlines$ARRIVAL_DELAY, delayAirlines$AIRLINE, "airlines", "time delay > 60", "Title")
box(log(delayAirlines$ARRIVAL_DELAY,10), delayAirlines$AIRLINE, "airlines", "time delay > 60", "Title")
#boxplot function I made earlier
box = function(values, by,X,Y,Title){
df = data.frame(values, by)
ggplot(df, aes(x = by, y = values)) +
geom_boxplot(color = "black", fill = "white") +
labs(x = X, y = Y,title = Title) +
scale_fill_brewer() +
theme(plot.title = element_text(size = 5, face = "bold"))
}
