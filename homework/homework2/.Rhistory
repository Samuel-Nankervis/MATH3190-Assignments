#borplot function I made
bar = function(values, by,X,Y,Title){
df = data.frame(values, by)
ggplot(midwest_summary, aes(x = by, y = values)) +
geom_bar(stat = "identity", color = "black", fill = "steelblue") +
labs(x = X, y = Y) +
ggtitle(Title) +
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18, face = "bold"))
}
bar(delayAirlines$`Average Delay`, delayAirlines$AIRLINE, "Airline", "log of time delays greater than 60 minutes", "Delays per Airline")
#| label: "boxplot of inner join airline with delay time"
#| fig-width: 40
#| fig-height: 20
#| out-width: "100%"
#| fig-align: "center"
#borplot function I made
bar = function(values, by,X,Y,Title){
df = data.frame(values, by)
ggplot(df, aes(x = by, y = values)) +
geom_bar(stat = "identity", color = "black", fill = "steelblue") +
labs(x = X, y = Y) +
ggtitle(Title) +
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18, face = "bold"))
}
bar(delayAirlines$`Average Delay`, delayAirlines$AIRLINE, "Airline", "log of time delays greater than 60 minutes", "Delays per Airline")
