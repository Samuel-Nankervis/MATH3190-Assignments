delayAirlines = (DBI::dbGetQuery(con, "SELECT airlines.airline, AVG(flights.arrival_delay) AS 'Average Delay' FROM flights INNER JOIN airlines ON flights.airline = airlines.iata_code WHERE arrival_delay > 60 GROUP BY airline"))
delayAirlines = (DBI::dbGetQuery(con, "SELECT airlines.airline, AVG(flights.arrival_delay) AS 'Average Delay' FROM flights INNER JOIN airlines ON flights.airline = airlines.iata_code WHERE arrival_delay > 60 GROUP BY airlines.airline"))
print(head(delayAirlines))
