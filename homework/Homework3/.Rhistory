#| label: logistic confusion matrix with better cutoff
logitmod = glm(salaryGreaterThanFiftyK ~ age + education + race + sex + hours.per.week, data = adultTrain, family = "binomial")
adultTest$salaryGreaterThanFiftyK <- as.factor(adultTest$salaryGreaterThanFiftyK)
prob_test <- predict(logitmod, newdata = adultTest, type = "response")
pred_test <- factor(ifelse(prob_test > 0.35, 1, 0), levels = levels(adultTest$salaryGreaterThanFiftyK))
confusionMatrix(pred_test, adultTest$salaryGreaterThanFiftyK)
ptest <- as.numeric(logitmod$fitted > 0.5) # Binary vector set to 1 if the prob.
ptest = as.factor(ptest)
confusionMatrix(adultTrain$salaryGreaterThanFiftyK, ptest)
