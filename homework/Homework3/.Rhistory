#| label: gradient decent beta
#not gonna lie I really don't know what I'm doing here. I pretty much just asked AI to do it for me. I don't see how I can work with the yi * the vector I got earlier, nor how to put that into a function format.
X <- cbind(1, x1, x2)
starting = c(0,0,0)
# The Log-Likelihood Function (Objective)
log_lik <- function(beta) {
eta <- X %*% beta
# We sum the log-likelihood for all observations
sum(y * eta - log(1 + exp(eta)))
}
# The Gradient Function
log_lik_grad <- function(beta) {
# Calculate predicted probabilities p_i for all i
p <- 1 / (1 + exp(-(X %*% beta)))
# The gradient is X' %*% (y - p)
# This performs the sum of (y_i - p_i) * x_ij for each j
as.vector(t(X) %*% (y - p))
}
# Initial guesses for Beta0, Beta1, Beta2
initial_beta <- c(0, 0, 0)
# Run your function
results <- gradient_desc(
starting = initial_beta,
f = log_lik,
gradient = log_lik_grad,
max = TRUE,
maxit = 200,
step_size = 0.1 # Smaller step size helps stability in logistic regression
)
print(results$x) # These are your MLE Beta coefficients!
print(results$x) # These are your MLE Beta coefficients!
salarymod
optim(starting, log_lik)
