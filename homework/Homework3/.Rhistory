theta_hatf = function(values){
loggedx = c()
for (i in values){
loggedx = c(loggedx, log(1-i))
}
df = data.frame(values)
denom = -sum(loggedx)
numer = count(df)
thetaHat = numer/denom
return(thetaHat)
}
set.seed(2026)
theta_hat <- rep(0, 10000) # Initialize the vector
values = c()
for (i in 1:1000) {
x_sim <- rbeta(100, 1, 7.3)
values = c(as.numeric(values),as.numeric(theta_hatf(x_sim)))
}
df = data.frame(values)
ggplot(df, aes(x = values)) +
geom_histogram(color = "black", fill = "limegreen") +
geom_vline(xintercept = 7.3)
