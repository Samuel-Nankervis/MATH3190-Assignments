#| label: optimize k
kvalues = seq(3,251,2)
accuracy <- map_df(kvalues, function(k){
fit <- knn3(salaryGreaterThanFiftyK ~ age + education + race + sex + hours.per.week, data = adultTrain, k = k)
y_hat <- predict(fit, adultTrain, type = "class")
cm_train <- confusionMatrix(y_hat, adultTrain$salaryGreaterThanFiftyK)
train_acc <- cm_train$overall["Accuracy"]
y_hat <- predict(fit, adultTrain, type = "class")
cm_test <- confusionMatrix(y_hat, adultTest$salaryGreaterThanFiftyK)
test_acc <- cm_test$overall["Accuracy"]
tibble(train = train_acc, test = test_acc)
})
