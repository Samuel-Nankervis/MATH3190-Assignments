"type vs. Humerus length")) +
theme_bw()
#b
breaks <- quantile(turkey$humerus, seq(0, 1, 0.2))
turkey_props <- turkey |>
mutate(group = factor(
case_when(
humerus >= 140 & humerus <= 145 ~ "140-145",
humerus >= 146 & humerus <= 148 ~ "146-148",
humerus >= 149 & humerus <= 150 ~ "149-150",
humerus >= 151 & humerus <= 153 ~ "151-153",
humerus >= 154 & humerus <= 169 ~ "154-169",
), levels = c("140-145", "146-148", "149-150", "151-153", "154-169")
),
) |>
group_by(group) |>
summarize(num_domestic = sum(type == 1),
num_wild = sum(type == 0),
props = sum(type == 1)/length(type)) |>
mutate(midpoints = breaks[1:5] + diff(breaks)/2)
ggplot(turkey, aes(x = humerus, y = type.convert(type, as.is = T))) +
geom_point() +
labs(x = "humerus length", y = "Wild or domestic turkey",
title = "Scatterplot of type vs. Humerus length") +
theme_bw() +
geom_point(data = turkey_props, aes(x = midpoints, y = props),
shape = 1, size = 4)
