?confusionMatrix
#| label: Cohen's Kappa Optomization
set.seed(123)
cutoff = c(0.15,0.20,0.25,0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70,0.75,0.80,0.85)
kappaValues = data.frame(value = as.character(), kapp = as.numeric())
for (i in cutoff){
folds = createFolds(adultTrain$salaryGreaterThanFiftyK, 5,FALSE)
adultTrain = mutate(adultTrain, fold = folds)
folder = c(1,2,3,4,5)
kappa = c()
for (k in folder){
df = filter(adultTrain, fold == as.factor(k))
df2 = filter(adultTrain, fold != as.factor(k))
logitmod = glm(salaryGreaterThanFiftyK ~ age + education + race + sex + hours.per.week, data = df2, family = "binomial")
prob_test <- predict(logitmod, newdata = adultTest, type = "response")
pred_test <- factor(ifelse(prob_test > i, 1, 0), levels = levels(adultTest$salaryGreaterThanFiftyK))
mat = as.numeric(confusionMatrix(df$salaryGreaterThanFiftyK, pred_test)$overall["Kappa"])
kappa = c(kappa,mat)
}
kappaValues = add_row(kappaValues, value = as.character(i), kapp = as.numeric(min(kappa)))
}
for (i in cutoff){
folds = createFolds(adultTrain$salaryGreaterThanFiftyK, 5,FALSE)
adultTrain = mutate(adultTrain, fold = folds)
