qqploter = function(data,model){
data |>
mutate(fitted = fitted.values(model),
jackknife = rstudent(model)) |>
ggplot(aes(sample = jackknife)) +
geom_qq(size = 2) +
geom_qq_line(linewidth = 1.2) +
labs(x = "Theoretical Quantiles",
y = "Sample Quantiles (Jackknife Residuals)",
title = "Normal Q-Q Plot") +
theme(axis.title = element_text(size = 16),
plot.title = element_text(size = 18, face = "bold"))
}
qqploter(concreteData, compMod)
