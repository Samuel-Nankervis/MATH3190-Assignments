#| label: predict_weighted function
predict_weighted = function(mod, values, type = "confidence"){
abs_resids <- abs(mod$residuals)
fitted <- mod$fitted.values
e_mod <- lm(abs_resids ~ fitted)
new_fit <- predict(mod, values)
new_weight <- 1/predict(e_mod, data.frame(fitted = new_fit))^2
prediction = predict(mod, values, interval=type, weight = new_weight)
return(as.numeric(prediction))
}
df = data.frame(cement =300, blastFurnaceSlag =90, flyAsh =50, water =200, superplasticizer = 2.5, coarseAggregate = 900, fineAggregate = 600, ageDays = 300)
