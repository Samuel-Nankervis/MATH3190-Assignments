histogramer = function(values,x,y,title){
#makes a bar chart for the States
df = data.frame(values)
ggplot(df, aes(x = values)) +
geom_histogram(color = "black", fill = "orange") +
lims(x = c(min(values), max(values))) +
labs(x = x,
y = y,
title = title) +
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18, face = "bold"))
}
histogramer(bootx$t,"x","Y","title")
histogramer(bootx$t,"IQR Size","Frequency","Distribution of IQR Bootstrap Output")
